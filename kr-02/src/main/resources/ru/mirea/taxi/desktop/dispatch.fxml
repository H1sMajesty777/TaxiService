<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="masthead">
            <VBox spacing="3">
                <Label text="Служба такси" styleClass="page-title"/>
                <Label text="Рабочее место диспетчера" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Обновить" onAction="#refresh"/>
            <Button text="Статистика" onAction="#showStatistics"/>
            <Button text="Экспорт Excel" onAction="#exportRides"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="workspace-tabs">
            <tabs>
                <Tab text="Заказы">
                    <VBox spacing="14" styleClass="workspace">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Button text="Новый заказ" onAction="#createRide" styleClass="primary"/>
                            <Button fx:id="editButton" text="Изменить" onAction="#editRide"/>
                            <Button fx:id="statusButton" text="Сменить статус" onAction="#changeStatus"/>
                            <Button fx:id="deleteButton" text="Удалить" onAction="#deleteRide" styleClass="danger"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <TextField fx:id="queryField" promptText="Адрес, пассажир или №" HBox.hgrow="ALWAYS"/>
                            <ComboBox fx:id="statusFilter" prefWidth="165" accessibleText="Фильтр по статусу"/>
                            <DatePicker fx:id="pickupDate" promptText="Дата подачи" prefWidth="150"
                                        accessibleText="Фильтр по дате подачи"/>
                            <Button text="Сбросить" onAction="#resetFilters"/>
                        </HBox>
                        <TableView fx:id="orderTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <placeholder><Label text="Заказы не найдены"/></placeholder>
                            <columns>
                                <TableColumn fx:id="orderId" text="№" prefWidth="50" minWidth="48" maxWidth="65"/>
                                <TableColumn fx:id="orderPassenger" text="Пассажир" prefWidth="150" minWidth="108"/>
                                <TableColumn fx:id="orderPickupTime" text="Подача · МСК" prefWidth="146" minWidth="132"/>
                                <TableColumn fx:id="orderPickup" text="Откуда" prefWidth="180" minWidth="110"/>
                                <TableColumn fx:id="orderDropoff" text="Куда" prefWidth="180" minWidth="110"/>
                                <TableColumn fx:id="orderFare" text="Сумма, ₽" prefWidth="99" minWidth="80"/>
                                <TableColumn fx:id="orderStatus" text="Статус" prefWidth="118" minWidth="105"/>
                            </columns>
                        </TableView>
                        <Label fx:id="passengerDetails" text="Выберите заказ, чтобы увидеть контакт пассажира."
                               styleClass="related"/>
                    </VBox>
                </Tab>
                <Tab text="Пассажиры">
                    <VBox spacing="12" styleClass="workspace">
                        <TableView fx:id="passengerTable" VBox.vgrow="ALWAYS">
                            <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/></columnResizePolicy>
                            <placeholder><Label text="Пассажиров пока нет"/></placeholder>
                            <columns>
                                <TableColumn fx:id="passengerId" text="№" prefWidth="70" maxWidth="110"/>
                                <TableColumn fx:id="passengerName" text="Имя пассажира" prefWidth="320"/>
                                <TableColumn fx:id="passengerPhone" text="Телефон" prefWidth="260"/>
                            </columns>
                        </TableView>
                    </VBox>
                </Tab>
            </tabs>
        </TabPane>
    </center>
    <bottom>
        <Label fx:id="footer" text="Подключение к PostgreSQL…" styleClass="footer" maxWidth="Infinity"/>
    </bottom>
</BorderPane>
